# ══════════════════════════════════════════════════════════════════════════════
# Syntrix — Root .gitignore
# Covers: Backend (Python/FastAPI), Frontend (React), and repo tooling
# ══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — never commit these, ever
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
aws_credentials
credentials


# ─────────────────────────────────────────────────────────────────────────────
# Python (Backend)
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Distribution / packaging
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl
MANIFEST

# pytest / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml

# mypy / pyright
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Logs from uvicorn / gunicorn
*.log
logs/


# ─────────────────────────────────────────────────────────────────────────────
# Node / React (Frontend)
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
Frontend/build/
Frontend/.pnp
Frontend/.pnp.js
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ─────────────────────────────────────────────────────────────────────────────
# OS artefacts
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini


# ─────────────────────────────────────────────────────────────────────────────
# IDE / editors
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/


# ─────────────────────────────────────────────────────────────────────────────
# AWS / cloud tooling
# ─────────────────────────────────────────────────────────────────────────────
.aws/
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
samconfig.toml