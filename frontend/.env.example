# ─── Syntrix Frontend — Environment Variables ─────────────────────────────────
# Copy to .env.local for local dev. Never commit .env.local to git.

# URL of your FastAPI backend (no trailing slash)
REACT_APP_API_BASE=http://localhost:8000

# Must match SYNTRIX_API_KEY in Backend/.env
REACT_APP_API_KEY=CHANGE_ME_same_as_backend_key
